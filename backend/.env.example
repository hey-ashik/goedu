# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public URL of the site (used for links in emails / share urls)
APP_URL=http://localhost:5173
# Comma separated list of allowed CORS origins (frontend dev server etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- MySQL (Hostinger -> Databases -> Management) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=goedu
DB_CONNECTION_LIMIT=10

# ---------- Auth ----------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Groq AI chatbot (https://console.groq.com/) ----------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Per-user chat rate limit: CHAT_LIMIT messages, then wait CHAT_WINDOW_MINUTES minutes
CHAT_LIMIT=10
CHAT_WINDOW_MINUTES=30
