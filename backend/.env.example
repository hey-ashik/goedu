# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public URL of the site (used for links in emails / share urls)
APP_URL=https://goedu.ashiik.com
# Comma separated list of allowed CORS origins (frontend dev server etc.)
CORS_ORIGINS=https://goedu.ashiik.com,https://www.goedu.ashiik.com

# ---------- MySQL (Hostinger -> Databases -> Management) ----------
# On Hostinger the app connects with DB_HOST=localhost. From your own PC use the
# "Remote MySQL" host shown in hPanel (e.g. srv1234.hstgr.io) and whitelist your IP.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u697802579_goeduuser
DB_PASSWORD=
DB_NAME=u697802579_goeedudb
DB_CONNECTION_LIMIT=10

# ---------- Auth ----------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Groq AI chatbot (https://console.groq.com/) ----------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Per-user chat rate limit: CHAT_LIMIT messages, then wait CHAT_WINDOW_MINUTES minutes
CHAT_LIMIT=10
CHAT_WINDOW_MINUTES=30

# ---------- Payments: SSLCommerz (https://sslcommerz.com) ----------
# Leave empty until your merchant account is ready: orders are then fulfilled directly.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# true = sandbox test gateway, false = live gateway
SSLCOMMERZ_SANDBOX=true

# ---------- First run ----------
# Create tables + load the catalogue automatically on boot (needs no terminal on the host)
AUTO_MIGRATE=true
# Create the demo learner demo@goedu.ac / Demo@1234 when seeding (keep false in production)
SEED_DEMO_USER=false
